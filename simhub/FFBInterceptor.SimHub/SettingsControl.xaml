<UserControl x:Class="FFBInterceptor.SimHub.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620" Background="#15181D" Foreground="#F4F6F8">
  <UserControl.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F6F8" /></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="#CFD6DE" /></Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,4,0,10" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="#242A31" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#4A5562" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Background" Value="#2E78D2" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#63A8FF" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="920" HorizontalAlignment="Left">
      <TextBlock Text="FFB INTERCEPTOR" FontSize="25" FontWeight="SemiBold" />
      <TextBlock Text="DirectInput 命令削峰偵測 · 非實際馬達扭力" Foreground="#9FAAB6" Margin="0,3,0,20" />

      <Border Background="#20262D" BorderBrush="#39434E" BorderThickness="1" Padding="16" Margin="0,0,0,20">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="StatusText" Text="等待遙測" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SourceText" Text="尚未連線" Foreground="#ABB5C0" Margin="0,4,0,0" />
          </StackPanel>
          <TextBlock x:Name="LevelText" Grid.Column="1" Text="0.0%" FontSize="30" FontWeight="Bold" Foreground="#64D3A3" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <TextBlock Text="偵測條件" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBlock Text="達到進入門檻連續指定時間，或在滑動視窗內的碰頂比例達標，即進入 CLIP；降到離開門檻以下並持續指定時間才解除。" TextWrapping="Wrap" Foreground="#ABB5C0" Margin="0,0,0,12" />
      <Grid Width="620" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="20" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0">
          <Label Content="進入門檻（%）" /><TextBox x:Name="EntryThresholdBox" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2">
          <Label Content="離開門檻（%）" /><TextBox x:Name="ExitThresholdBox" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0">
          <Label Content="連續碰頂時間（ms）" /><TextBox x:Name="ContinuousBox" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2">
          <Label Content="碰頂比例（%）" /><TextBox x:Name="RatioBox" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0">
          <Label Content="比例視窗（ms）" /><TextBox x:Name="WindowBox" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2">
          <Label Content="解除保持時間（ms）" /><TextBox x:Name="ExitHoldBox" />
        </StackPanel>
      </Grid>

      <TextBlock Text="來源選擇" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,8" />
      <CheckBox x:Name="AutoSelectCheckBox" Content="自動選擇最近有活動的 producer" Foreground="#F4F6F8" Margin="0,0,0,10" Checked="SourceModeChanged" Unchecked="SourceModeChanged" />
      <Grid Width="620" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="20" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"><Label Content="手動 PID（0 代表任意）" /><TextBox x:Name="ManualPidBox" /></StackPanel>
        <StackPanel Grid.Column="2"><Label Content="手動 Session ID（空白代表任意）" /><TextBox x:Name="ManualSessionBox" /></StackPanel>
      </Grid>

      <TextBlock x:Name="ValidationText" Foreground="#FF8A80" TextWrapping="Wrap" Margin="0,4,0,12" />
      <StackPanel Orientation="Horizontal">
        <Button Content="套用設定" Click="ApplyClick" />
        <Button Content="恢復預設值" Background="#39434E" Click="DefaultsClick" />
        <Button Content="清除峰值" Background="#39434E" Click="ResetPeakClick" />
      </StackPanel>

      <Border BorderBrush="#39434E" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
        <StackPanel>
          <TextBlock Text="資料管線" FontWeight="SemiBold" />
          <TextBlock Text="\\.\pipe\ffb-interceptor-simhub-v1 · 僅接受本機、目前 Windows 使用者，並驗證 Hello PID。" Foreground="#ABB5C0" Margin="0,4,0,0" />
          <TextBlock x:Name="StartupErrorText" Foreground="#FF8A80" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
